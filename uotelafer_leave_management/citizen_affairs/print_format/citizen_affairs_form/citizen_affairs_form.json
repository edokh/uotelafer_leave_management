 "html": "<div dir=\"rtl\" style=\"border: 2px solid #000; padding: 16px; font-family: 'Cairo', Tahoma, sans-serif; font-size: 13px; color: #000; line-height: 1.6;\">\n\n    <!-- Header Section -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 12px; border-bottom: 2px solid #000; padding-bottom: 10px;\">\n        <tr>\n            <td style=\"width: 35%; text-align: right; vertical-align: middle; font-weight: bold; font-size: 13px;\">\n                <div>وزارة التعليم العالي والبحث العلمي</div>\n                <div style=\"margin-top: 3px;\">جامعة تلعفر</div>\n                <div style=\"margin-top: 3px;\">شعبة شؤون المواطنين</div>\n            </td>\n            <td style=\"width: 35%; text-align: center; vertical-align: middle;\">\n                <div style=\"font-size: 18px; font-weight: 900; border: 1.5px solid #000; padding: 6px 12px; border-radius: 6px; display: inline-block; background: #f8fafc;\">\n                    استمارة شؤون المواطنين (ش م)\n                </div>\n                <div style=\"margin-top: 6px; font-weight: bold; font-size: 13px; color: #1e40af;\">\n                    رقم الطلب: {{ doc.name }}\n                </div>\n            </td>\n            <td style=\"width: 30%; text-align: left; vertical-align: middle;\">\n                <img src=\"/assets/uotelafer_leave_management/logo.jpg\" style=\"height: 5.5rem; object-fit: contain; border-radius: 8px;\">\n            </td>\n        </tr>\n    </table>\n\n    <!-- Section 1: Applicant Information Table -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 14px;\">\n        <tr>\n            <td colspan=\"4\" style=\"border: 1.5px solid #000; background: #e2e8f0; font-weight: 800; padding: 6px 10px; font-size: 14px;\">\n                أولاً: معلومات مقدم الطلب\n            </td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; width: 18%; background: #f8fafc;\">رقم الطلب:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; width: 32%; font-weight: bold; color: #1d4ed8;\">{{ doc.name }}</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; width: 18%; background: #f8fafc;\">تاريخ التقديم:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; width: 32%;\">{{ doc.creation_date or frappe.utils.formatdate(doc.creation) }}</td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">الاسم الرباعي:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: 700;\">{{ doc.full_name }}</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">المهنة / الوظيفة:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px;\">{{ doc.occupation or '-' }}</td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">العنوان (المحافظة/القرية):</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px;\">{{ doc.address_area or '-' }}</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">الجهة المعنية بالطلب:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: 700;\">{{ doc.target_department }}</td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">رقم الهاتف:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px;\">{{ doc.phone_number }}</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">البريد الإلكتروني:</td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px;\">{{ doc.email }}</td>\n        </tr>\n    </table>\n\n    <!-- Section 2: Request Subject & Details -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 14px;\">\n        <tr>\n            <td style=\"border: 1.5px solid #000; background: #e2e8f0; font-weight: 800; padding: 6px 10px; font-size: 14px;\">\n                ثانياً: موضوع وتفاصيل الطلب\n            </td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; font-weight: bold; background: #f8fafc;\">\n                م / موضوع الطلب: <span style=\"color: #1e40af; font-weight: 800;\">{{ doc.request_subject or 'طلب شؤون مواطنين' }}</span>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 14px 10px; min-height: 110px; vertical-align: top; white-space: pre-wrap; line-height: 1.8;\">{{ doc.request_details }}</td>\n        </tr>\n        {% if doc.attachment_1 or doc.attachment_2 %}\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 6px 10px; font-size: 12px; background: #f8fafc;\">\n                <strong>المرفقات الداعمة:</strong>\n                {% if doc.attachment_1 %} | <span>المرفق 1: {{ doc.attachment_1 }}</span> {% endif %}\n                {% if doc.attachment_2 %} | <span>المرفق 2: {{ doc.attachment_2 }}</span> {% endif %}\n            </td>\n        </tr>\n        {% endif %}\n    </table>\n\n    <!-- Section 3: Applicant Pledge & Signature -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n        <tr>\n            <td colspan=\"2\" style=\"border: 1.5px solid #000; background: #e2e8f0; font-weight: 800; padding: 6px 10px; font-size: 14px;\">\n                ثالثاً: التعهد الإداري والتوقيع\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"2\" style=\"border: 1px solid #000; padding: 10px; background: #fef9c3; font-weight: 700; text-align: center;\">\n                \" ألتزم بصحة المعلومات الواردة في الطلب وأتحمل المسؤولية القانونية والإدارية كافة وعليه أوقع \"\n            </td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 10px; width: 50%; font-weight: bold;\">\n                توقيع مقدم الطلب: <span style=\"font-weight: 800; color: #1e40af;\">{{ doc.applicant_signature_name or doc.full_name }}</span>\n            </td>\n            <td style=\"border: 1px solid #000; padding: 10px; width: 50%; font-weight: bold;\">\n                تاريخ التوقيع والتقديم: <span>{{ doc.applicant_submission_date or doc.creation_date }}</span>\n            </td>\n        </tr>\n    </table>\n\n    <!-- Section 4: Citizen Affairs Official Section -->\n    <table style=\"width: 100%; border-collapse: collapse; border: 2px solid #000;\">\n        <tr>\n            <td colspan=\"3\" style=\"border: 1.5px solid #000; background: #cbd5e1; font-weight: 900; padding: 8px 10px; font-size: 14px; text-align: center;\">\n                رابعاً: القسم الإداري (يملى من قبل شعبة شؤون المواطنين / الجهة المعنية)\n            </td>\n        </tr>\n        <tr>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; width: 35%; font-weight: bold;\">\n                اسم مستلم الطلب: <span style=\"font-weight: normal;\">{{ doc.receiver_name or '-' }}</span>\n            </td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; width: 35%; font-weight: bold;\">\n                توقيع المستلم: <span style=\"font-weight: normal;\">{{ doc.receiver_signature or '' }}</span>\n            </td>\n            <td style=\"border: 1px solid #000; padding: 8px 10px; width: 30%; font-weight: bold;\">\n                تاريخ الاستلام: <span style=\"font-weight: normal;\">{{ doc.receipt_date or '-' }}</span>\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"3\" style=\"border: 1px solid #000; padding: 10px; min-height: 60px; vertical-align: top;\">\n                <strong style=\"display: block; margin-bottom: 4px; color: #1e40af;\">التوصية:</strong>\n                <div style=\"white-space: pre-wrap; min-height: 40px;\">{{ doc.recommendation or '................................................................................................................................................' }}</div>\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"3\" style=\"border: 1px solid #000; padding: 12px 10px; background: #f8fafc;\">\n                <strong style=\"margin-left: 20px;\">القرار الإداري:</strong>\n                <span style=\"display: inline-block; margin-left: 30px; font-weight: bold;\">\n                    [ {% if doc.decision == 'قبول الطلب' or doc.status == 'Accepted' %}✓{% else %} &nbsp; {% endif %} ] &nbsp; قبول الطلب\n                </span>\n                <span style=\"display: inline-block; font-weight: bold;\">\n                    [ {% if doc.decision == 'رفض الطلب' or doc.status == 'Rejected' %}✓{% else %} &nbsp; {% endif %} ] &nbsp; رفض الطلب\n                </span>\n            </td>\n        </tr>\n        {% if doc.decision == 'رفض الطلب' or doc.status == 'Rejected' %}\n        <tr>\n            <td colspan=\"3\" style=\"border: 1px solid #000; padding: 10px; background: #fef2f2; color: #991b1b;\">\n                <strong>مبررات وأسباب رفض الطلب:</strong>\n                <div style=\"white-space: pre-wrap; margin-top: 4px;\">{{ doc.rejection_reasons or '-' }}</div>\n            </td>\n        </tr>\n        {% endif %}\n        <tr>\n            <td colspan=\"2\" style=\"border: 1px solid #000; padding: 12px 10px; font-weight: bold;\">\n                مسؤول شعبة شؤون المواطنين: <span style=\"color: #1e40af; font-weight: 800;\">{{ doc.ca_officer_name or '-' }}</span>\n            </td>\n            <td style=\"border: 1px solid #000; padding: 12px 10px; font-weight: bold; text-align: center;\">\n                التوقيع والتاريخ: <span>{{ doc.ca_officer_date or '-' }}</span>\n            </td>\n        </tr>\n    </table>\n\n    <!-- Footer note -->\n    <div style=\"margin-top: 12px; text-align: center; font-size: 11px; color: #64748b; border-top: 1px dashed #94a3b8; padding-top: 6px;\">\n        تم استخراج وتوليد هذه الاستمارة إلكترونياً عبر نظام إدارة شؤون المواطنين في جامعة تلعفر\n    </div>\n</div>",
